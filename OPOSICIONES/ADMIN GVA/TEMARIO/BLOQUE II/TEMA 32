=HIPERVINCULO(ubicacion_del_vinculo; [nombre_descriptivo])

Argumentos
Argumento	Obligatorio	Descripción
ubicacion_del_vinculo	Si	Ruta del archivo, URL o referencia de celda destino como texto
nombre_descriptivo	No	Texto visible en la celda como enlace (aparece en azul subrayado). Si se omite, muestra la URL
Ejemplos

=HIPERVINCULO("https://www.boe.es"; "Ver BOE")

=HIPERVINCULO("[Libro1.xlsx]Hoja1!A10"; "Ir a Hoja1 > A10")

=HIPERVINCULO("\\SERVIDOR\Informes\2025.xlsx"; D5)

